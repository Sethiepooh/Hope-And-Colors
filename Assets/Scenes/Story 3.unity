  dialogue:
  - text: CHILD /*sobbing*
    profileSprite: {fileID: 0}
  - text: CHILD /I'm sorry...
    profileSprite: {fileID: 0}
  - text: CHILD /I'm so sorry...
    profileSprite: {fileID: 0}
  - text: CHILD /I never meant to...
    profileSprite: {fileID: 0}
  - text: EVIE /Hey buddy...
    profileSprite: {fileID: 0}
  - text: EVIE /You alright?
    profileSprite: {fileID: 0}
  - text: EVIE /What are you doing all the way down here?
    profileSprite: {fileID: 0}
  - text: CHILD /They were huring them...
    profileSprite: {fileID: 0}
  - text: CHILD /I was trying to protect them...
    profileSprite: {fileID: 0}
  - text: CHILD /I never meant for any of this...
    profileSprite: {fileID: 0}
  - text: EVIE /Hey buddy this isn't your fault...
    profileSprite: {fileID: 0}
  - text: EVIE /But we need to get you out of here as soon as possible
    profileSprite: {fileID: 0}
  - text: EVIE /It's not safe down her-
    profileSprite: {fileID: 0}
  - text: CHILD /Who are you?
    profileSprite: {fileID: 0}
  - text: EVIE /My name's Evie
    profileSprite: {fileID: 0}
  - text: CHILD /Why are you here?
    profileSprite: {fileID: 0}
  - text: EVIE /I'm just try-
    profileSprite: {fileID: 0}
  - text: CHILD /That arm...
    profileSprite: {fileID: 0}
  - text: CHILD /you're one of them arent you?
    profileSprite: {fileID: 0}
  - text: EVIE /No i-
    profileSprite: {fileID: 0}
  - text: CHILD /YOU GUYS DID THIS!
    profileSprite: {fileID: 0}
  - text: CHILD /I'LL KILL YOU!!
    profileSprite: {fileID: 0}
  - text: CHILD /I SWER I'LL KILL YOU!!
    profileSprite: {fileID: 0}
  - text: EVIE /shit...
    profileSprite: {fileID: 0}
