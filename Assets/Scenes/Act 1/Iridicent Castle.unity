    speaker: 0
    speakerExpression: 8
    screenEffect: 0
    soundEffect: 0
    lineEvents:
      m_PersistentCalls:
        m_Calls: []
  - dialogueLine: "If I stay here I\u2019ll lose myself, and everything you taught
      me."
    DialogueUIState: 1
    unskippable: 0
    goToNextLineAutomatically: 0
    autoAdvanceDelay: 0
    actions: []
    cameraState: 0
    cameraTransitionTime: 0
    cameraTarget: {fileID: 0}
