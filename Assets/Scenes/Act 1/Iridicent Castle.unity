    cameraFocus: 0
    changeScene: 0
    sceneIndex: 0
    speakerData: []
    speaker: 2
    speakerExpression: 0
    screenEffect: 0
    soundEffect: 0
    lineEvents:
      m_PersistentCalls:
        m_Calls: []
  - dialogueLine: "Do you have ANY idea of what father\u2019s going to do to you
      when I drag you home"
    DialogueUIState: 1
    unskippable: 0
    goToNextLineAutomatically: 0
    autoAdvanceDelay: 0
    action: 2
    activateBeforeAction: 0
    actionTarget: {fileID: 0}
    endPos: {fileID: 0}
