    speaker: 2
    speakerExpression: 0
    screenEffect: 0
    soundEffect: 0
    lineEvents:
      m_PersistentCalls:
        m_Calls: []
  - dialogueLine: "I- I\u2019m not\u2026"
    DialogueUIState: 1
    unskippable: 0
    goToNextLineAutomatically: 0
    autoAdvanceDelay: 0
    action: 2
    activateBeforeAction: 0
    actionTarget: {fileID: 0}
    endPos: {fileID: 0}
