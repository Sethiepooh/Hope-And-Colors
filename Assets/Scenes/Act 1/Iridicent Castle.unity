        m_Calls: []
  - dialogueLine: EVIE!!!
    DialogueUIState: 1
    unskippable: 0
    goToNextLineAutomatically: 0
    autoAdvanceDelay: 0
    action: 0
    activateBeforeAction: 1
    actionTarget: {fileID: 183747114}
