    obscureSpeaker: 0
    speakerName: 
    speaker: 0
    speakerExpression: 8
    screenEffect: 0
    soundEffect: 0
    lineEvents:
      m_PersistentCalls:
        m_Calls: []
  - dialogueLine: "I don\u2019t think there ever was\u2026"
    DialogueUIState: 1
    unskippable: 0
    goToNextLineAutomatically: 0
    autoAdvanceDelay: 0
    actions: []
    cameraState: 0
    cameraTransitionTime: 0
    cameraTarget: {fileID: 0}
    cameraFocus: 0
