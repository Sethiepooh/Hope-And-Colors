    speakerData: []
    speaker: 2
    speakerExpression: 0
    screenEffect: 0
    soundEffect: 0
    lineEvents:
      m_PersistentCalls:
        m_Calls: []
  - dialogueLine: Stay back!
    DialogueUIState: 1
    unskippable: 0
    goToNextLineAutomatically: 0
    autoAdvanceDelay: 0
    action: 0
    activateBeforeAction: 0
    actionTarget: {fileID: 898841780}
    endPos: {fileID: 1545002896}
    actionDuration: 1
    cameraState: 0
    cameraTransitionTime: 0
    cameraTarget: {fileID: 0}
    cameraFocus: 0
    changeScene: 0
    sceneIndex: 0
    speakerData: []
    speaker: 2
    speakerExpression: 0
    screenEffect: 0
    soundEffect: 0
    lineEvents:
      m_PersistentCalls:
        m_Calls: []
  - dialogueLine: "Look at you\u2026"
    DialogueUIState: 1
    unskippable: 0
    goToNextLineAutomatically: 0
    autoAdvanceDelay: 0
    action: 2
    activateBeforeAction: 0
    actionTarget: {fileID: 0}
    endPos: {fileID: 0}
    actionDuration: 1
    cameraState: 0
    cameraTransitionTime: 0
    cameraTarget: {fileID: 0}
    cameraFocus: 0
    changeScene: 0
    sceneIndex: 0
    speakerData: []
    speaker: 2
    speakerExpression: 0
    screenEffect: 0
    soundEffect: 0
    lineEvents:
      m_PersistentCalls:
        m_Calls: []
  - dialogueLine: "I haven\u2019t even sung a note and you\u2019re trembling"
    DialogueUIState: 1
    unskippable: 0
    goToNextLineAutomatically: 0
    autoAdvanceDelay: 0
    action: 2
    activateBeforeAction: 0
    actionTarget: {fileID: 0}
