    soundEffect: 0
    lineEvents:
      m_PersistentCalls:
        m_Calls: []
  - dialogueLine: Oh?
    DialogueUIState: 1
    unskippable: 0
    goToNextLineAutomatically: 0
    autoAdvanceDelay: 0
    action: 2
    activateBeforeAction: 0
    actionTarget: {fileID: 0}
    endPos: {fileID: 0}
    actionDuration: 0
    cameraState: 0
