    speaker: 2
    speakerExpression: 0
    screenEffect: 0
    soundEffect: 0
    lineEvents:
      m_PersistentCalls:
        m_Calls: []
  - dialogueLine: So the little firefly finally grew a spine?
    DialogueUIState: 1
    unskippable: 0
    goToNextLineAutomatically: 0
    autoAdvanceDelay: 0
    action: 2
    activateBeforeAction: 0
    actionTarget: {fileID: 0}
    endPos: {fileID: 0}
    actionDuration: 0
    cameraState: 0
    cameraTransitionTime: 0
    cameraTarget: {fileID: 0}
    cameraFocus: 0
    changeScene: 0
    sceneIndex: 0
    speakerData: []
    speaker: 2
    speakerExpression: 0
    screenEffect: 0
    soundEffect: 0
    lineEvents:
      m_PersistentCalls:
        m_Calls: []
  - dialogueLine: "You roughed up a few PAWNs and now you\u2019re a big girl is that
      it?"
    DialogueUIState: 1
    unskippable: 0
    goToNextLineAutomatically: 0
    autoAdvanceDelay: 0
    action: 2
    activateBeforeAction: 0
    actionTarget: {fileID: 0}
    endPos: {fileID: 0}
    actionDuration: 0
    cameraState: 0
    cameraTransitionTime: 0
    cameraTarget: {fileID: 0}
    cameraFocus: 0
    changeScene: 0
    sceneIndex: 0
    speakerData: []
    speaker: 2
    speakerExpression: 0
    screenEffect: 0
    soundEffect: 0
    lineEvents:
      m_PersistentCalls:
        m_Calls: []
  - dialogueLine: "Well then don\u2019t be afraid little sister."
    DialogueUIState: 1
    unskippable: 0
    goToNextLineAutomatically: 0
    autoAdvanceDelay: 0
    action: 2
    activateBeforeAction: 0
    actionTarget: {fileID: 0}
    endPos: {fileID: 0}
    actionDuration: 0
    cameraState: 0
    cameraTransitionTime: 0
    cameraTarget: {fileID: 0}
    cameraFocus: 0
    changeScene: 0
    sceneIndex: 0
    speakerData: []
    speaker: 2
    speakerExpression: 0
    screenEffect: 0
    soundEffect: 0
    lineEvents:
      m_PersistentCalls:
        m_Calls: []
  - dialogueLine: "Why don\u2019t you come fight a real a real artist!"
    DialogueUIState: 1
    unskippable: 0
    goToNextLineAutomatically: 0
    autoAdvanceDelay: 0
    action: 0
    activateBeforeAction: 0
    actionTarget: {fileID: 183747114}
