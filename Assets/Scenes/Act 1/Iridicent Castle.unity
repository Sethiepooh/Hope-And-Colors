    cameraTransitionTime: 0
    cameraTarget: {fileID: 0}
    cameraFocus: 0
    changeScene: 0
    sceneIndex: 0
    speakerData: []
    speaker: 0
    speakerExpression: 0
    screenEffect: 0
    soundEffect: 0
    lineEvents:
      m_PersistentCalls:
        m_Calls: []
  - dialogueLine: "You\u2019re not what?"
    DialogueUIState: 1
    unskippable: 0
    goToNextLineAutomatically: 0
    autoAdvanceDelay: 0
    action: 2
    activateBeforeAction: 0
    actionTarget: {fileID: 0}
    endPos: {fileID: 0}
    actionDuration: 0
    cameraState: 0
    cameraTransitionTime: 0
    cameraTarget: {fileID: 0}
    cameraFocus: 0
