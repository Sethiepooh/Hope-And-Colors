    speaker: 0
    speakerExpression: 8
    screenEffect: 0
    soundEffect: 0
    lineEvents:
      m_PersistentCalls:
        m_Calls: []
  - dialogueLine: "So I\u2019m leaving\u2026 to see the world you told me about "
