    obscureSpeaker: 0
    speakerName: 
    speaker: 0
    speakerExpression: 8
    screenEffect: 0
    soundEffect: 0
    lineEvents:
      m_PersistentCalls:
        m_Calls: []
  - dialogueLine: "Maybe I already have\u2026"
    DialogueUIState: 1
    unskippable: 0
    goToNextLineAutomatically: 0
    autoAdvanceDelay: 0
    actions: []
    cameraState: 0
    cameraTransitionTime: 0
    cameraTarget: {fileID: 0}
    cameraFocus: 0
    changeScene: 0
    sceneIndex: 0
    speakerData:
    - {fileID: 3927479120916938436, guid: ca2b28aa41327a448ab2399eb57b1176, type: 3}
