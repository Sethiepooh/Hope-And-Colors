    speaker: 2
    speakerExpression: 0
    screenEffect: 0
    soundEffect: 0
    lineEvents:
      m_PersistentCalls:
        m_Calls: []
  - dialogueLine: "I\u2019m not going back with you."
    DialogueUIState: 1
    unskippable: 0
    goToNextLineAutomatically: 0
    autoAdvanceDelay: 0
    action: 2
    activateBeforeAction: 0
