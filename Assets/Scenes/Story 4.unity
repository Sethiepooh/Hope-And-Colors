--- !u!114 &1887495445
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1887495444}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6a3da6d75de9ac84d8f9548b38bb03eb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  playerMovement: {fileID: 725162962}
  dialogue:
  - text: EVIE /Please... listen...
    profileSprite: {fileID: 0}
  - text: EVIE /I'm not with Nakamura...
    profileSprite: {fileID: 0}
  - text: EVIE /I'm not with the chief...
    profileSprite: {fileID: 0}
  - text: EVIE /I'm just...here to help...
    profileSprite: {fileID: 0}
  - text: EVIE /So please, listen to me...
    profileSprite: {fileID: 0}
  - text: CHILD /...
    profileSprite: {fileID: 0}
  - text: CHILD /ok...
    profileSprite: {fileID: 0}
  - text: EVIE /What's your name?
    profileSprite: {fileID: 0}
  - text: ALIX /Alix...
    profileSprite: {fileID: 0}
  - text: EVIE /I'm Evie...
    profileSprite: {fileID: 0}
  - text: EVIE /What happened here?
    profileSprite: {fileID: 0}
  - text: ALIX /They made mom and dad come down here...
    profileSprite: {fileID: 0}
  - text: ALIX /Cause they didn't have enough money...
    profileSprite: {fileID: 0}
  - text: ALIX /They told me to stay behind but I didn't listen...
    profileSprite: {fileID: 0}
  - text: ALIX /I tried to save them...
    profileSprite: {fileID: 0}
  - text: ALIX /So that we could run away together...
    profileSprite: {fileID: 0}
  - text: ALIX /But the soldiers caught me...
    profileSprite: {fileID: 0}
  - text: ALIX /They were yelling and pointing their guns at me...
    profileSprite: {fileID: 0}
  - text: ALIX /Then dad started to yell...
    profileSprite: {fileID: 0}
  - text: ALIX /and then...
    profileSprite: {fileID: 0}
  - text: ALIX /then everything went blurry...
    profileSprite: {fileID: 0}
  - text: ALIX /That's when I found them... like that...
    profileSprite: {fileID: 0}
  - text: EVIE /...
    profileSprite: {fileID: 0}
  - text: ALIX /It's all my fault...
    profileSprite: {fileID: 0}
  - text: ALIX /They're gone cause I didn't listen...
    profileSprite: {fileID: 0}
  - text: ALIX /Cause I couldn't control the noise...
    profileSprite: {fileID: 0}
  - text: EVIE /Hey this isn't your fault...
    profileSprite: {fileID: 0}
  - text: EVIE /You're just a kid... with way to much responsibility to carry alone...
    profileSprite: {fileID: 0}
  - text: EVIE /And stuck in a system that thrives off of moments like this...
    profileSprite: {fileID: 0}
  - text: EVIE /Off of the pain and despair...
    profileSprite: {fileID: 0}
  - text: EVIE /Alix I know it seems hopeless right now...
    profileSprite: {fileID: 0}
  - text: EVIE /And I know that you feel like you burnt down your own world
    profileSprite: {fileID: 0}
  - text: EVIE /But I promise you...
    profileSprite: {fileID: 0}
  - text: EVIE /Your parents wouldn't hate for what happened today
    profileSprite: {fileID: 0}
  - text: EVIE /And they don't want you to stay down here to get dragged off to who
      knows where
    profileSprite: {fileID: 0}
  - text: EVIE /So please Alix
    profileSprite: {fileID: 0}
  - text: EVIE /Take my hand and we'll walk out of here...
    profileSprite: {fileID: 0}
  - text: ALIX /Where will we go?
    profileSprite: {fileID: 0}
  - text: ALIX /They'll know it was me... and the-
    profileSprite: {fileID: 0}
  - text: EVIE /Let me worry about that.
    profileSprite: {fileID: 0}
  - text: EVIE /You worry about how your heart survives this
    profileSprite: {fileID: 0}
  - text: ALIX /...
    profileSprite: {fileID: 0}
  - text: ALIX /ok
    profileSprite: {fileID: 0}
  speakers:
  - name: EVIE
    textColor: {r: 0.86274517, g: 0.46274513, b: 0.9960785, a: 1}
  - name: CHILD
    textColor: {r: 0.09411766, g: 0.40784317, b: 0.7960785, a: 1}
  - name: ALIX
    textColor: {r: 0.094645746, g: 0.40895388, b: 0.79622644, a: 1}
  - name: INNER-THOUGHTS
    textColor: {r: 0.7584905, g: 0.7584905, b: 0.7584905, a: 1}
  transitionDialogue: 1
  delay: 0.05
  dialogueCanvas: {fileID: 725162961}
  text: {fileID: 725162960}
  title: {fileID: 725162959}
  canInteract: 1
  active: 0
